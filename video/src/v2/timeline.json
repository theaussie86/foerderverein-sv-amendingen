  "cues": [
    {
      "start": 0.0,
      "end": 6.553,
      "text": "Servus, ich bin Manu, Jugendtrainer und Vorsitzender\nvom Förderverein des SV Amendingen Fußball."
    },
    {
      "start": 6.758,
      "end": 8.868,
      "text": "Als Kind habe ich hier selbst gekickt."
    },
    {
      "start": 9.118,
      "end": 12.948,
      "text": "Heute möchte ich, dass unsere Kinder\ngenauso gern auf diesem Platz stehen."
    },
    {
      "start": 13.118,
      "end": 15.948,
      "text": "Mit 20 Euro im Jahr kannst du dabei helfen."
    },
    {
      "start": 16.358,
      "end": 19.948,
      "text": "Trainer, Eltern und Helfer\nbringen jede Woche ihre Zeit ein."
    },
    {
      "start": 20.398,
      "end": 23.008,
      "text": "Aber Ehrenamt kauft keine Bälle."
    },
    {
      "start": 23.218,
      "end": 25.328,
      "text": "Dafür gibt es unseren Förderverein."
    },
    {
      "start": 25.618,
      "end": 27.448,
      "text": "Jeder Euro bleibt in Amendingen."
    },
    {
      "start": 27.812,
      "end": 30.542,
      "text": "Wir haben die Jugendfahrt\nnach Augsburg bezuschusst,"
    },
    {
      "start": 30.782,
      "end": 34.202,
      "text": "bei Trainingsanzügen geholfen,\nBälle und Hütchen gekauft"
    },
    {
      "start": 34.332,
      "end": 36.565,
      "text": "und die neue Schuhwaschanlage\nbezuschusst."
    },
    {
      "start": 36.936,
      "end": 38.266,
      "text": "Das kommt bei den Kindern an."
    },
    {
      "start": 38.646,
      "end": 41.146,
      "text": "Deine Mitgliedschaft kostet 20 Euro im Jahr."
    },
    {
      "start": 41.486,
      "end": 46.276,
      "text": "Zusammen bringen 25 Mitglieder schon\n500 Euro für Trainingsmaterial auf."
    },
    {
      "start": 46.616,
      "end": 49.186,
      "text": "Niemand muss viel geben,\nwenn viele mitmachen."
    },
    {
      "start": 49.494,
      "end": 51.824,
      "text": "Wir sind schon über 100 Mitglieder."
    },
    {
      "start": 52.234,
      "end": 54.892,
      "text": "Lass uns gemeinsam die 150 knacken."
    },
    {
      "start": 55.241,
      "end": 58.401,
      "text": "Die Anmeldung dauert zwei Minuten\nund geht komplett online."
    },
    {
      "start": 58.741,
      "end": 61.521,
      "text": "Mach mit.\nFür die Kinder auf unserem Platz."
    }
  ]
}
