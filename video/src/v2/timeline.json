  "cues": [
    { "start": 0.0, "end": 5.3, "text": "Servus, ich bin Manu, Jugendtrainer und\nVorsitzender des Fördervereins beim SVA." },
    { "start": 5.5, "end": 7.61, "text": "Als Kind habe ich hier selbst gekickt." },
    { "start": 7.86, "end": 11.69, "text": "Heute möchte ich, dass unsere Kinder\ngenauso gern auf diesem Platz stehen." },
    { "start": 11.86, "end": 14.69, "text": "Mit 20 Euro im Jahr kannst du dabei helfen." },
    { "start": 15.1, "end": 18.69, "text": "Trainer, Eltern und Helfer\nbringen jede Woche ihre Zeit ein." },
    { "start": 19.14, "end": 21.75, "text": "Aber Ehrenamt kauft keine Bälle." },
    { "start": 21.96, "end": 24.07, "text": "Dafür gibt es unseren Förderverein." },
    { "start": 24.36, "end": 26.19, "text": "Jeder Euro bleibt in Amendingen." },
    { "start": 26.55, "end": 29.05, "text": "Wir haben die Jugendfahrt\nnach Augsburg bezuschusst," },
    { "start": 29.1, "end": 32.05, "text": "bei Trainingsanzügen geholfen,\nBälle und Hütchen gekauft" },
    { "start": 32.45, "end": 35.06, "text": "und das Jugendcamp mit dem\nFC Bayern unterstützt." },
    { "start": 35.43, "end": 36.76, "text": "Das kommt bei den Kindern an." },
    { "start": 37.14, "end": 39.64, "text": "Deine Mitgliedschaft kostet 20 Euro im Jahr." },
    { "start": 39.98, "end": 44.77, "text": "Zusammen bringen 25 Mitglieder schon\n500 Euro für Trainingsmaterial auf." },
    { "start": 45.11, "end": 47.68, "text": "Niemand muss viel geben,\nwenn viele mitmachen." },
    { "start": 47.99, "end": 49.91, "text": "Wir sind schon über 80 Mitglieder." },
    { "start": 50.2, "end": 52.05, "text": "Lass uns gemeinsam die hundert knacken." },
    { "start": 52.4, "end": 55.56, "text": "Die Anmeldung dauert zwei Minuten\nund geht komplett online." },
    { "start": 55.9, "end": 58.68, "text": "Mach mit.\nFür die Kinder auf unserem Platz." }
  ]
}
