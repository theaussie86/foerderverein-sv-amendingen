# Basis-URL für die Links in den Bestätigungsmails
SITE_URL=https://foerderverein-sv-amendingen.de

# Schlüssel für die verschlüsselten Unterschriftslinks (mind. 32 Zeichen),
# z. B. erzeugen mit: openssl rand -base64 48
ANTRAG_SECRET=

# Wer die unterschriebenen Anträge (PDF) bekommt
ANTRAG_EMPFAENGER=vorstand@example.org

# Wer Anfragen für Zuwendungsbestätigungen über 300 € bekommt, i. d. R. der Vorsitz (optional, sonst ANTRAG_EMPFAENGER).
# Bis 300 € geht der Beleg automatisch an den Spender.
QUITTUNG_EMPFAENGER=

# Mailversand über Resend. Ohne RESEND_API_KEY werden Mails nur ins Log geschrieben (lokale Entwicklung).
RESEND_API_KEY=
# Nur die Adresse, der Anzeigename kommt aus src/lib/verein.ts
MAIL_FROM=noreply@foerderverein-sv-amendingen.de

# PocketBase (intern im dokploy-network). Ohne POCKETBASE_URL wird nichts gespeichert (lokale Entwicklung).
# Eigener Superuser nur für die Website.
POCKETBASE_URL=http://foerderverein-pocketbase:8090
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
