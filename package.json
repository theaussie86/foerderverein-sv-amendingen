{
  "name": "foerderverein-sv-amendingen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "prepare": "husky",
    "typegen": "bun --bun next typegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run typegen && eslint . --max-warnings=0",
    "typecheck": "bun run typegen && tsc --noEmit",
    "lint:boundaries": "depcruise src",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run lint:boundaries && bun run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "next": "^16",
    "pdf-lib": "^1.17.1",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.72.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "bun@1.4.4",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
